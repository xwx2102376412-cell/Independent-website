{
  "name": "rivet-ebikes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:storefront": "next dev -p 3000",
    "dev:admin": "next dev admin-app -p 3001",
    "build": "npm run build:storefront && npm run build:admin",
    "build:storefront": "next build",
    "build:admin": "next build admin-app",
    "start": "next start",
    "start:storefront": "next start -p 3000",
    "start:admin": "next start admin-app -p 3001",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:storefront && npm run typecheck:admin",
    "typecheck:storefront": "tsc --noEmit",
    "typecheck:admin": "tsc --noEmit -p admin-app/tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@phosphor-icons/react": "latest",
    "@prisma/client": "6.12.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "geist": "^1.7.2",
    "jose": "latest",
    "motion": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "6.12.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
